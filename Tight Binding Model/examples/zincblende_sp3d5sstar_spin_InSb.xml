<?xml version="1.0" encoding="UTF-8"?>
<dory>
  <!-- Orbital set per site -->
  <basis> sp3d5s* </basis>

  <!-- Lattice constant (InSb) -->
  <lattice_constant units="nm">0.64794</lattice_constant>
  
  <!-- Two-atom zincblende unit cell: A=In (cation) at (0,0,0), B=Sb (anion) at (a/4,a/4,a/4) -->
  <atoms>
    <atom id="A" pos="0.0 0.0 0.0"/>             <!-- In -->
    <atom id="B" pos="0.161985 0.161985 0.161985"/>   <!-- Sb -->
  </atoms>

  <!-- Four tetrahedral nearest-neighbour bonds δ_j = ±(a/4)(1,1,1) permutations -->
  <neighbors>
    <bond from="A" to="B" delta=" 0.161985  0.161985  0.161985"/>
    <bond from="A" to="B" delta=" 0.161985 -0.161985 -0.161985"/>
    <bond from="A" to="B" delta="-0.161985  0.161985 -0.161985"/>
    <bond from="A" to="B" delta="-0.161985 -0.161985  0.161985"/>
  </neighbors>

  <!-- Onsite energies (eV) from InSb column -->
  <onsite>
    <!-- In (cation): E_s^c, E_p^c, E_d, E_{s*}; Sb (anion): E_s^a, E_p^a, E_d, E_{s*} -->
    <A s="0.3389" p="6.4919" d_t2g="11.2647" d_eg="11.2647" sstar="16.1664"/>
    <B s="-4.9527" p="4.0797" d_t2g="11.2647" d_eg="11.2647" sstar="16.1664"/>
  </onsite>

  <!-- Slater–Koster parameters for In–Sb (eV) -->
  <sk builtin="true">
    <!-- AB: A=In(c) -> B=Sb(a) -->
    <AB
      ss_sigma="-1.1290"
      sstar_sstar_sigma="-3.5234"
      sstar_s_sigma="-2.0042"
      s_sstar_sigma="-1.8189"
      sp_sigma="2.6980"
      ps_sigma="2.5362"
      sstar_p_sigma="2.3471"
      p_sstar_sigma="2.7380"
      sd_sigma="-2.3085"
      ds_sigma="-2.5635"
      sstar_d_sigma="-0.8144"
      d_sstar_sigma="-0.7371"
      pp_sigma="4.1830"
      pp_pi="-1.4688"
      pd_sigma="-2.1652"
      pd_pi="1.8491"
      dp_sigma="-2.1487"
      dp_pi="1.8642"
      dd_sigma="-1.3052"
      dd_pi="2.0748"
      dd_delta="-1.4118"
    />
    <!-- BA: A=Sb(a) -> B=In(c) -->
    <BA
      ss_sigma="-1.1290"
      sstar_sstar_sigma="-3.5234"
      sstar_s_sigma="-1.8189"
      s_sstar_sigma="-2.0042"
      sp_sigma="2.5362"
      ps_sigma="2.6980"
      sstar_p_sigma="2.7380"
      p_sstar_sigma="2.3471"
      sd_sigma="-2.5635"
      ds_sigma="-2.3085"
      sstar_d_sigma="-0.7371"
      d_sstar_sigma="-0.8144"
      pp_sigma="4.1830"
      pp_pi="-1.4688"
      pd_sigma="-2.1487"
      pd_pi="1.8642"
      dp_sigma="-2.1652"
      dp_pi="1.8491"
      dd_sigma="-1.3052"
      dd_pi="2.0748"
      dd_delta="-1.4118"
    />
  </sk>

  <spin enable="true"
      Delta_a_over_3="0.4495"
      Delta_c_over_3="0.1230"
      Delta_d_a="0.0"
      Delta_d_c="0.0"/>

</dory>
