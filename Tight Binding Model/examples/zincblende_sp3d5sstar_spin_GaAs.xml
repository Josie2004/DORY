<?xml version="1.0" encoding="UTF-8"?>
<dory>
  <!-- Orbital set per site -->
  <basis> sp3d5s* </basis>

  <!-- Lattice constant (GaAs) -->
  <lattice_constant units="nm">0.56532</lattice_constant>
  
  <!-- Two-atom zincblende unit cell: A=Ga (cation) at (0,0,0), B=As (anion) at (a/4,a/4,a/4) -->
  <atoms>
    <atom id="A" pos="0.0 0.0 0.0"/>         <!-- Ga -->
    <atom id="B" pos="0.14133 0.14133 0.14133"/>   <!-- As -->
  </atoms>

  <!-- Four tetrahedral nearest-neighbour bonds δ_j = ±(a/4)(1,1,1) permutations -->
  <neighbors>
    <bond from="A" to="B" delta=" 0.14133  0.14133  0.14133"/>
    <bond from="A" to="B" delta=" 0.14133 -0.14133 -0.14133"/>
    <bond from="A" to="B" delta="-0.14133  0.14133 -0.14133"/>
    <bond from="A" to="B" delta="-0.14133 -0.14133  0.14133"/>
  </neighbors>

  <!-- Onsite energies (eV) from GaAs column (Vogl et al.) -->
