    <A s="-0.4028" p="6.3853" d_t2g="13.1023" d_eg="13.1023" sstar="19.4220"/>
    <B s="-5.9819" p="3.5826" d_t2g="13.1023" d_eg="13.1023" sstar="19.4220"/>
  </onsite>

