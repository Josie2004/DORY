<?xml version="1.0" encoding="UTF-8"?>
<dory>
  <!-- Orbital set per site -->
  <basis> s </basis>

  <!-- Lattice constant -->
  <lattice_constant units="nm">0.543</lattice_constant>
  
  <!-- Two-atom unit cell (diamond/zincblende) -->
  <atoms>
    <atom id="A" pos="0.0 0.0 0.0"/>                 <!-- Si at τ_A -->
    <atom id="B" pos="0.13575 0.13575 0.13575"/>     <!-- τ_B = (a/4, a/4, a/4), with a=0.543 nm -->
  </atoms>

  <!-- Four tetrahedral NN A→B bonds δ_j = ±(a/4)(1,1,1) permutations -->
  <neighbors>
    <bond from="A" to="B" delta=" 0.13575  0.13575  0.13575"/>
    <bond from="A" to="B" delta=" 0.13575 -0.13575 -0.13575"/>
    <bond from="A" to="B" delta="-0.13575  0.13575 -0.13575"/>
    <bond from="A" to="B" delta="-0.13575 -0.13575  0.13575"/>
  </neighbors>

  <!-- Onsite energies (eV) -->
  <onsite>
    <A s="-2.803316" p="4.096984"/>
    <B s="-2.803316" p="4.096984"/>
  </onsite>

  <!-- Slater–Koster parameters (Si-like, in eV) -->
  <sk builtin="true">
    <AB
      ss_sigma="-2.066560"
      sp_sigma=" 3.144266"
      ps_sigma=" 3.144266"
      pp_sigma=" 4.122363"
      pp_pi   ="-1.522175"
    />
    <BA
      ss_sigma="-2.066560"
      sp_sigma=" 3.144266"
      ps_sigma="-3.144266"
      pp_sigma=" 4.122363"
      pp_pi   ="-1.522175"
    />
  </sk>
</dory>